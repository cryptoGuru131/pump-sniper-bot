{
  "name": "pumpfun-sniper",
  "version": "1.0.0",
  "description": "Low-latency Pump.fun token sniper: new token detection + migration alerts via Yellowstone gRPC",
  "license": "MIT",
  "author": "",
  "engines": { "node": ">=18.0.0" },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "fetch": "TRADING_ENABLED=false node src/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "pump.fun",
    "solana",
    "sniper",
    "grpc",
    "yellowstone",
    "triton"
  ],
  "dependencies": {
    "@pump-fun/pump-sdk": "^1.31.0",
    "@pump-fun/pump-swap-sdk": "^1.14.1",
    "@solana/web3.js": "^1.95.0",
    "@triton-one/yellowstone-grpc": "^5.0.2",
    "bn.js": "^5.2.3",
    "bs58": "^4.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.0.0"
  }
}
