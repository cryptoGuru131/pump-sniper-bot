# gRPC - switch provider with one line: triton | helius
GRPC_PROVIDER=triton

# Triton (when GRPC_PROVIDER=triton)
GRPC_TOKEN_TRITON=your-triton-token
# Or use GRPC_ENDPOINT + GRPC_TOKEN for custom endpoint

# Helius (when GRPC_PROVIDER=helius)
GRPC_TOKEN_HELIUS=your-helius-token

# RPC for sending transactions
RPC_URL=https://your-rpc-endpoint.com/your-token

# Wallet (base58 private key or path to keypair JSON)
PRIVATE_KEY=your-base58-private-key
# KEYPAIR_PATH=./keypair.json

# Trading
BUY_AMOUNT_SOL=0.01
SLIPPAGE_BPS=100
TRADING_ENABLED=true
# BUY_PRIORITY_FEE_SOL=0.001  # priority fee for buy tx (default 0.001 SOL)
# TRADING_MODE=fast  # fast | safe | same-block
# TOKEN_FILTER_ADDRESS_SUFFIX=pump  # only tokens whose mint address ends with this (empty = no filter)
# AUTO_SELL_ENABLED=true   # sell 3s after successful buy
# AUTO_SELL_DELAY_MS=3000
